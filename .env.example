# ==========================================================
# SANADCHAIN ENVIRONMENT CONFIGURATION (.env.example)
# ==========================================================

PORT=3000
NODE_ENV=development
JWT_SECRET=sanadchain-super-secure-production-jwt-secret-2026

# Database
DATABASE_URL=postgres://sanad_admin:sanad_secure_password_2026@localhost:5432/sanadchain_db

# Blockchain (Hyperledger Fabric vs Development Simulator)
MOCK_BLOCKCHAIN=true
FABRIC_NETWORK=sanadchain-network
FABRIC_CHANNEL=sanadchannel
FABRIC_CHAINCODE=sanad-credential-contract
FABRIC_MSP_ID=ABCUniversityMSP
FABRIC_CA_URL=https://localhost:7054
FABRIC_PEER_URL=grpcs://localhost:7051
FABRIC_ORDERER_URL=grpcs://localhost:7050

# Storage & Document Vault
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=sanadchain-vault

# DigiLocker / NAD Gateway
NAD_MODE=mock
NAD_API_URL=https://api.nad.digilocker.gov.in/mock/v2
NAD_CLIENT_ID=sanad_nad_client_demo
NAD_CLIENT_SECRET=sanad_nad_secret_demo
